# Sao chép thành .env và điền giá trị cục bộ. KHÔNG commit .env.
PORT=3000
NODE_ENV=development
DATABASE_URL=postgres://l4_user:change_me@localhost:5432/l4_dev

# Chỉ dùng khi chạy bằng Docker Compose (docker-compose.yml ghép DATABASE_URL từ ba biến này)
DB_NAME=l4_dev
DB_USER=l4_user
DB_PASSWORD=change_me
# Cổng máy chủ trên máy bạn khi chạy bằng Docker (đổi nếu cổng 3000 đang bận)
API_PORT=3000
# Số kết nối tối đa trong pool (tùy chọn, mặc định 10)
DB_POOL_MAX=10
# Hai biến JWT dưới đây CHƯA được dùng: đăng nhập chưa làm (TD-18)
JWT_SECRET=change_me_to_a_long_random_string
JWT_EXPIRES_IN=8h
TZ=Asia/Ho_Chi_Minh
# Giờ làm việc cho lịch hẹn (BR-L4-01)
WORK_START=08:00
WORK_END=17:30
APPOINTMENT_MINUTES=30

# Mức log: debug | info | warn | error (log JSON ra stdout)
LOG_LEVEL=info
