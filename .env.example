# Sao chép thành .env:  cp .env.example .env   (KHÔNG commit .env). Giá trị mẫu dưới đây chạy được ngay bằng Docker Compose;
# khi triển khai thật hãy đổi DB_PASSWORD (và DATABASE_URL nếu chạy bằng npm).

# ----- Máy chủ API -----
PORT=3000
NODE_ENV=development
# Chỉ dùng khi chạy bằng npm (npm start, npm run migrate/seed). Docker Compose tự ghép chuỗi này từ DB_*.
DATABASE_URL=postgres://l4_user:change_me@localhost:5432/l4_dev
# Số kết nối tối đa trong pool (tùy chọn, mặc định 10)
DB_POOL_MAX=10
# Mức log: debug | info | warn | error (log JSON ra stdout)
LOG_LEVEL=info
TZ=Asia/Ho_Chi_Minh

# ----- Chỉ dùng khi chạy bằng Docker Compose -----
DB_NAME=l4_dev
DB_USER=l4_user
DB_PASSWORD=change_me
# Cổng của máy bạn trỏ vào API (đổi nếu cổng 3000 đang bận)
API_PORT=3000

# Chưa có biến nào cho đăng nhập/JWT: hệ thống chưa làm xác thực (TD-18, TD-28).
