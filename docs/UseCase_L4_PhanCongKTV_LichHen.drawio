<mxfile host="app.diagrams.net"><diagram id="uc-l4" name="UseCase-L4"><mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1250" pageHeight="800" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="sys" value="Hệ thống: Phân công kỹ thuật viên và lịch hẹn (luồng L4)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeWidth=2;verticalAlign=top;fontStyle=1;fontSize=14;" vertex="1" parent="1"><mxGeometry x="200" y="20" width="780" height="720" as="geometry"/></mxCell><mxCell id="a1" value="Quản lý trung tâm" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="70" y="310" width="30" height="60" as="geometry"/></mxCell><mxCell id="a2" value="Kỹ thuật viên" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1080" y="130" width="30" height="60" as="geometry"/></mxCell><mxCell id="a3" value="Khách hàng" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=12;" vertex="1" parent="1"><mxGeometry x="1080" y="330" width="30" height="60" as="geometry"/></mxCell><mxCell id="uc1" value="UC1: Xem danh sách phiếu chưa phân công" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="250" y="90" width="270" height="90" as="geometry"/></mxCell><mxCell id="uc3" value="UC3: Gán kỹ thuật viên cho phiếu" style="ellipse;whiteSpace=wrap;html=1;fillColor=#FFE6CC;strokeColor=#D79B00;fontSize=12;" vertex="1" parent="1"><mxGeometry x="250" y="240" width="270" height="90" as="geometry"/></mxCell><mxCell id="uc2" value="UC2: Xem kỹ thuật viên phù hợp và khối lượng công việc" style="ellipse;whiteSpace=wrap;html=1;fillColor=#DAE8FC;strokeColor=#6C8EBF;fontSize=12;" ver